# Secrets loaded into `bin/kamal deploy` at runtime. This file is safe to
# commit — it only references how to fetch secrets, never the values.
#
# Sources of the actual values (pick one per secret):
#   • local file:    $(cat config/master.key)
#   • shell env:     $VAR_NAME
#   • 1Password:     $(kamal secrets fetch --adapter 1password ...)
#
# Everything referenced here is looked up by name in config/deploy.yml
# under env.secret, registry.password, or accessories.*.env.secret.

# Rails master key — decrypts config/credentials.yml.enc in production.
RAILS_MASTER_KEY=$(cat config/master.key)

# GitHub PAT with `write:packages` scope, used to push/pull ghcr.io images.
# Recommended: store in the shell env or a password manager; do NOT hard-code.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Postgres password for the `collectiveplayer_games` DB user.
# Generate once (e.g. `openssl rand -hex 32`) and put it in your env
# (~/.zshenv, direnv, 1Password) — Kamal reads it from ENV on each deploy.
POSTGRES_PASSWORD=$COLLECTIVEPLAYER_GAMES_DB_PASSWORD
